{
  "name": "pomodorozin",
  "type": "module",
  "main": "src/index.tsx",
  "scripts": {
    "dev": "bun --watch src/index.tsx",
    "start": "bun src/index.tsx",
    "compile": "bun build --compile src/index.tsx --outfile pomodoro",
    "playground": "bun --watch playground/index.tsx",
    "format": "bunx prettier --write src/**/*.{ts,tsx}",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "3.9.6"
  },
  "dependencies": {
    "@opentui/core": "^0.4.3",
    "@opentui/react": "^0.4.3",
    "react": "^19.2.7"
  }
}
